# App
PORT=8080
NODE_ENV=development

# Auth
JWT_SECRET=fn9ew4yrf49gfy7u49gfoy4g94gyu4wgy948gyh8y2hb80qybowfo8yn08q0opniubgqpne804qg84ygn8o4eiyognyeiwbgg
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_SECRET=hhuernyg8v9v4n5vyn4ygvb9ny4gbvwn9ycvy9nernivfwynb9e8ybwn8bgyw8ybgf8yebgr9fvwey8ogby8ero
REFRESH_TOKEN_DAYS=30

# Mongo
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/yupacgo?retryWrites=true&w=majority

# Redis (optional — caching disables gracefully if unset)
REDIS_URL=redis://localhost:6379

# Market data providers
FINNHUB_API_KEY=your_finnhub_key
TWELVEDATA_API_KEY=your_twelvedata_key
ALPHAVANTAGE_API_KEY=your_alphavantage_key

# Email (Resend — HTTP API, works on Render's free tier; SMTP does not, see AUDIT_AND_UPGRADE_PLAN.md)
RESEND_API_KEY=re_your_key
EMAIL_FROM=hello@yourdomain.com

# Frontend URL (used in email links)
FRONTEND_URL=https://www.yourdomain.com

# CORS — comma-separated extra origins beyond the ones hardcoded in server.js
ALLOWED_ORIGINS=

# FX fallback rate (NGN per 1 USD) used only if the live rate lookup fails
FX_FALLBACK_NGN_PER_USD=1550

# Error monitoring (optional — no-op until set; see src/config/sentry.js)
SENTRY_DSN=

# Admin seed (scripts/seedAdmin.js)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me

# Payment (not yet wired up)
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
